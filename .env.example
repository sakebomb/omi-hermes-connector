# Omi → assistant bridge configuration. Copy to .env and fill in.
# NEVER commit a real .env — it holds secrets.

# Your assistant's OpenAI-compatible gateway (chat/completions)
HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=replace-me

# Shared secret embedded in the webhook path (Omi webhooks are unsigned; this is the guard)
OMI_WEBHOOK_TOKEN=generate-a-long-random-hex-string

# Chat Tools: only this Omi user id may invoke the ask_hermes tool (from the ?uid= Omi sends)
OMI_USER_UID=your-omi-user-id

# Listener port
OMI_BRIDGE_PORT=8646

# --- optional tuning ---
# Extra privacy denylist terms (comma-separated) added to the built-in defaults.
# Put personal names / sensitive keywords here (kept out of source control on purpose).
OMI_DENYLIST=
# Omi conversation categories that must never leave the box (replaces default set).
OMI_PRIVATE_CATEGORIES=family,health,medical,personal,relationship
# Dedup TTL (seconds) for repeated Omi deliveries of the same conversation id.
OMI_DEDUP_TTL=180
# Synchronous timeout (seconds) for the Chat Tools ask_hermes gateway call.
OMI_TOOL_TIMEOUT=60

# Zulip DM delivery (used by the legacy realtime path; optional)
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=
OPERATOR_EMAIL=
